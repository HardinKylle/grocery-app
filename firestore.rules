rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The allow-list lives in config/allowlist ({ emails: [...] }), set by
    // the owner in the Firebase console. Store emails in lowercase.
    // No client can read or write it:
    // nothing below matches config/*, so it falls to the default deny.
    function isAllowListed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
           in get(/databases/$(database)/documents/config/allowlist).data.emails;
    }

    function isOwner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && isAllowListed();
    }

    // All of an Account's data lives under its own path.
    match /accounts/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
