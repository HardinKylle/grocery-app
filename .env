VITE_FIREBASE_VAPID_KEY=BF8npj_ikQ2IfEURWng6m3uVZcJP-d5WndysOoGPwoRE9koAdOyXqm5wyHDiEaDuW_jqD7xDw4W04gdLcwTifkU

